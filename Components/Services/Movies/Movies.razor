@using BlazorApp.Components.HTML.Table
@using BlazorApp.Components.HTML.Tbody
@using BlazorApp.Components.HTML.Thead
@using BlazorApp.Components.HTML.Tr
@using BlazorApp.Components.HTML.Th
@using BlazorApp.Components.HTML.A
@using BlazorApp.Components.Filters.Search
@using BlazorApp.Components.Filters.Checkboxes
@using BlazorApp.Components.Filters.Checkboxes.Checkbox
@using MovieModel = BlazorApp.Services.Movies.Movie.Types.Movie
@using BlazorApp.Services.Movies.Movie.Types
@using BlazorApp.Lib.Filters
@using BlazorApp.Lib.Filters.Actions.Create

<Search @bind-Value="filter.Title" placeholder="Filter by title..." aria-label="Filter movies by title" />

<Checkboxes>
    <Checkbox @bind-Checked="filter.OnlyRecent">Released since 2000</Checkbox>
</Checkboxes>

<Table>
    <Thead>
        <Tr>
            <Th>Title</Th>
            <Th>Release date</Th>
        </Tr>
    </Thead>
    <Tbody>
        @foreach (MovieModel movie in FilteredMovies)
        {
            if (movie != null && movie.Slug != null)
            {
                <A href="@(value: $"/movies/{movie?.Slug.Current}")">
                    @movie?.Title
                </A>
            }
        }
    </Tbody>
</Table>

@if (!FilteredMovies.Any())
{
    <p>No movies match your filter.</p>
}

@code {
    private readonly MovieFilter filter = new MovieFilter();
    private readonly Filter<MovieModel> filters = new();

    [CascadingParameter]
    public MovieModel[] movies { get; set; } = Array.Empty<MovieModel>();

    protected override void OnParametersSet() =>
        filters.Setup(
            movies,
            [CreateFilter.Option(FilterOptionType.TextSearch, "Title", "Title")],
            [CreateFilter.Rule<MovieModel>("Recent", "Released since 2000", m => m.IsReleasedSince(2000))]);

    private IEnumerable<MovieModel> FilteredMovies => filters
        .SetValue("Title", filter.Title)
        .SetRuleActive("Recent", filter.OnlyRecent)
        .Run();
}
