@page "/movies"
@inherits Page<Movie[]>
@inject HttpClient Http
@inject IJSRuntime JS
@using BlazorApp.Lib.Razor.Pages
@using BlazorApp.Services.Movies.Movie.Types
@using BlazorApp.Components.Services.Movies
@using BlazorApp.Components.HTML.H1
@using BlazorApp.Components.HTML.P

<PageTitle>
    Movies
</PageTitle>

<H1>
    Movies
</H1>

@if (Loading)
{
    <P><em>Loading...</em></P>
}
else if (Data is null or { Length: 0 })
{
    <P>No movies found.</P>
}
else
{
    <CascadingValue Value="Data">
        <Movies />
    </CascadingValue>
}

@code {
    private bool logged;

    protected override async Task<Movie[]?> LoadAsync() =>
        await Http.GetFromJsonAsync<Movie[]>("api/Movies/all");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Data != null && !logged)
        {
            logged = true;
            await JS.InvokeVoidAsync("console.log", "Sanity movies:", Data);
        }
    }
}
