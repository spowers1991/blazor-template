
@page "/weather"
@inject IJSRuntime JS
@inject HttpClient Http
@using BlazorApp.Components.Services.Weather.Forecasts.WeatherTable
@using BlazorApp.Services.Weather.Forecasts.Forecast.Types

@using BlazorApp.Components.HTML.H1
@using BlazorApp.Components.HTML.P

<PageTitle>
    Weather
</PageTitle>

<H1>
    Weather
</H1>

<P>
    This component demonstrates showing data.
</P>



@if (forecasts == null || forecasts.Length == 0)
{
    <P><em>Loading...</em></P>
}
else
{
    <CascadingValue Value="forecasts">
        <WeatherTable  />
    </CascadingValue>
}


@code {
    private Forecast[] forecasts = Array.Empty<Forecast>();

    protected override async Task OnInitializedAsync()
    {
        forecasts = await Http.GetFromJsonAsync<Forecast[]>("api/Forecasts/all") ?? Array.Empty<Forecast>();
    }
}
